diff --git a/Auth/firebase_messaging/fcmpushclient.py b/Auth/firebase_messaging/fcmpushclient.py
index 3d4b7fc..b63eccc 100644
--- a/Auth/firebase_messaging/fcmpushclient.py
+++ b/Auth/firebase_messaging/fcmpushclient.py
@@ -72,6 +72,26 @@ _logger = logging.getLogger(__name__)
 OnNotificationCallable = Callable[[dict[str, Any], str, Any], None]
 CredentialsUpdatedCallable = Callable[[dict[str, Any]], None]
 
+
+def _decode_urlsafe_base64(value: str) -> bytes:
+    """Decode a urlsafe base64 string, tolerating missing '=' padding.
+    Google sometimes sends the crypto-key / salt without padding; the strict
+    decoder would raise 'Incorrect padding' and the location push would be lost."""
+    encoded = value.encode("ascii")
+    return urlsafe_b64decode(encoded + b"=" * (-len(encoded) % 4))
+
+
+def _header_parameter(value: str, name: str) -> str:
+    """Pull one parameter out of a ';'-separated header (e.g. 'dh=...;rs=4096').
+    Upstream assumed a fixed order and sliced fixed offsets, which grabbed the
+    wrong bytes whenever Google reordered, quoted, or spaced the parameters."""
+    for parameter in value.split(";"):
+        key, separator, parameter_value = parameter.strip().partition("=")
+        if separator and key.lower() == name.lower():
+            return parameter_value.strip().strip('"')
+    raise ValueError(f"Missing {name} parameter")
+
+
